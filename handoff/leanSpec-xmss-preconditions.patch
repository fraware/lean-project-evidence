+    def test_ci_mismatched_proposal_key_rejected_without_signing(
+        self, sync_service: SyncService, key_manager: XmssKeyManager
+    ) -> None:
+        """Refuse a local proposal key bound to another on-chain validator."""
+        service, block = self._setup(sync_service, key_manager)
+        own = service.registry.get(ValidatorIndex(0))
+        assert own is not None
+        other = _make_entry(key_manager, 1)
+        service.registry.add(
+            ValidatorEntry(
+                index=ValidatorIndex(0),
+                attestation_secret_key=own.attestation_secret_key,
+                proposal_secret_key=other.proposal_secret_key,
+            )
+        )
+        with patch(_SCHEME) as scheme:
+            with pytest.raises(ValueError, match="does not match"):
+                service._sign_block(block, ValidatorIndex(0), [])
+            scheme.sign.assert_not_called()
 
