{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/lpe/0.3.0/pilot-protocol.schema.json",
  "title": "PilotProtocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "project_id",
    "repository_remote",
    "repository_commit_at_freeze",
    "contract_freeze_id",
    "sample_size_min",
    "sample_size_max",
    "recruitment_window_start",
    "recruitment_window_end",
    "persistence_followup_days",
    "condition_design",
    "endpoints",
    "exclusion_rules",
    "stopping_rules",
    "held_out_set_hash",
    "analysis_plan_hash",
    "reviewer_roster_hash"
  ],
  "properties": {
    "schema_version": { "const": "0.3.0" },
    "protocol_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "repository_remote": { "type": "string", "minLength": 1 },
    "repository_commit_at_freeze": { "type": "string", "minLength": 1 },
    "contract_freeze_id": { "type": "string", "minLength": 1 },
    "sample_size_min": { "type": "integer", "minimum": 30, "maximum": 50 },
    "sample_size_max": { "type": "integer", "minimum": 30, "maximum": 50 },
    "recruitment_window_start": { "type": "string", "format": "date" },
    "recruitment_window_end": { "type": "string", "format": "date" },
    "persistence_followup_days": { "type": "integer", "minimum": 1 },
    "condition_design": { "type": "object" },
    "endpoints": { "type": "object" },
    "exclusion_rules": { "type": "array", "minItems": 1 },
    "stopping_rules": { "type": "array", "minItems": 1 },
    "held_out_set_hash": { "type": "string", "minLength": 1 },
    "analysis_plan_hash": { "type": "string", "minLength": 1 },
    "reviewer_roster_hash": { "type": "string", "minLength": 1 }
  }
}
