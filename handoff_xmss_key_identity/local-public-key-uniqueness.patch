+        # Reject repeated declared key identities before loading any secrets.
+        # Records are indexed by validator and role, so one public key assigned
+        # to two local signing identities would bypass their independent guards.
+        seen_public_keys: dict[Bytes52, tuple[ValidatorIndex, str]] = {}
+        for assigned_index in assigned_indices:
+            manifest_entry = manifest_by_index.get(ValidatorIndex(assigned_index))
+            if manifest_entry is None:
+                continue
+
+            if manifest_entry.attestation_public_key_hex == manifest_entry.proposal_public_key_hex:
+                raise ValueError(
+                    "Attestation and proposal keys must differ for validator "
+                    f"{assigned_index}, but the manifest assigns the same key to both"
+                )
+
+            for role, public_key in (
+                ("attestation", manifest_entry.attestation_public_key_hex),
+                ("proposal", manifest_entry.proposal_public_key_hex),
+            ):
+                previous = seen_public_keys.get(public_key)
+                if previous is not None:
+                    previous_index, previous_role = previous
+                    raise ValueError(
+                        "XMSS public key reused across locally controlled signing identities: "
+                        f"validator {previous_index} {previous_role} and "
+                        f"validator {assigned_index} {role}"
+                    )
+                seen_public_keys[public_key] = (ValidatorIndex(assigned_index), role)
+
+        # Load keys for assigned validators.
+        registry = cls()
+        manifest_directory = manifest_path.parent
+
+        for validator_index in assigned_indices:
