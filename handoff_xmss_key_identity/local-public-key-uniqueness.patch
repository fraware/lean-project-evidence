diff --git a/tests/node/validator/test_registry.py b/tests/node/validator/test_registry.py
--- a/tests/node/validator/test_registry.py
+++ b/tests/node/validator/test_registry.py
@@ -536,8 +536,60 @@
             "Attestation and proposal keys must differ for validator 0, "
             "but the manifest assigns the same key to both"
         )
 
+    @pytest.mark.parametrize(
+        ("first_role", "second_role"),
+        [
+            ("attestation", "attestation"),
+            ("attestation", "proposal"),
+            ("proposal", "attestation"),
+            ("proposal", "proposal"),
+        ],
+    )
+    def test_duplicate_public_key_among_assigned_validators_raises_before_key_load(
+        self, tmp_path: Path, first_role: str, second_role: str
+    ) -> None:
+        """All cross-validator declared-key collisions are rejected before secret loading."""
+        validators_file = tmp_path / "validators.yaml"
+        validators_file.write_text(yaml.dump({"node_0": [0, 1]}))
+
+        first = _manifest_entry_dict(0)
+        second = _manifest_entry_dict(1)
+        second[f"{second_role}_public_key_hex"] = first[f"{first_role}_public_key_hex"]
+
+        manifest_file = tmp_path / "manifest.yaml"
+        _write_manifest(manifest_file, [first, second])
+
+        # Deliberately omit all key files. Identity validation must precede decoding.
+        with pytest.raises(
+            ValueError, match="XMSS public key reused across locally controlled signing identities"
+        ):
+            ValidatorRegistry.from_yaml(
+                node_id="node_0",
+                validators_path=validators_file,
+                manifest_path=manifest_file,
+            )
+
+    def test_duplicate_key_on_other_node_is_outside_local_loader_scope(
+        self, tmp_path: Path, km: XmssKeyManager
+    ) -> None:
+        """A local registry validates its controlled set, not another node's key custody."""
+        validators_file = tmp_path / "validators.yaml"
+        validators_file.write_text(yaml.dump({"node_0": [0], "node_1": [1]}))
+
+        first = _manifest_entry_dict(0)
+        second = _manifest_entry_dict(1)
+        second["proposal_public_key_hex"] = first["attestation_public_key_hex"]
+        manifest_file = tmp_path / "manifest.yaml"
+        _write_manifest(manifest_file, [first, second])
+        self._write_real_key_files(km, tmp_path, [0])
+
+        registry = ValidatorRegistry.from_yaml(
+            node_id="node_0", validators_path=validators_file, manifest_path=manifest_file
+        )
+        assert set(registry.indices()) == {ValidatorIndex(0)}
+
     def test_only_assigned_node_keys_are_loaded(self, tmp_path: Path, km: XmssKeyManager) -> None:
         """Keys for validators belonging to other nodes are never touched."""
         validators_file = tmp_path / "validators.yaml"
         validators_file.write_text(yaml.dump({"node_0": [0], "node_1": [1, 2]}))
